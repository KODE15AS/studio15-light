# Studio 15 LIGHT — secrets (norm «kontoer»: .env per stack, chmod 600,
# ALDRI i git; masterkopi i Bitwarden, KODE15-hvelvet).

# Anthropic-nøkkelen bor KUN her (leses av LLM-proxyen) — aldri i
# arbeidsflate-containerne.
ANTHROPIC_API_KEY=sk-ant-...

# Felles master-nøkkel mot proxyen (beslutning 03.10). Zoo Code i
# arbeidsflatene autentiserer med denne. Generer f.eks. med:
#   openssl rand -hex 24
LITELLM_MASTER_KEY=sk-s15l-...

# Vaktmester-appen (GitHub App for repo-automatikk i program-orgene).
# Privatnøkkelen (.pem) ligger i certs/vaktmester.pem (gitignorert);
# masterkopi i Bitwarden (KODE15-hvelvet).
GITHUB_APP_ID=5176150
GITHUB_APP_KEY_FILE=/certs/vaktmester.pem
