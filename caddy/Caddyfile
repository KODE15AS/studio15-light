# Intern reverse proxy for Studio 15 LIGHT — IKKE offentlig ingress.
# To innganger med identisk ruting (snippeten «ruting» under):
#
#   :8100  HTTPS via tailscale-sertifikat — tailnettet (PC-er med Tailscale,
#          veggen på raven).
#   :8101  HTTP — studio-wifi (LAN). compose binder denne KUN til ravens
#          statiske LAN-IP (10.5.0.22:8100), aldri offentlig. Nettbrett og
#          PC-er på samme wifi slipper dermed Tailscale-oppsett.
#
#   /                  → lobbyen (programmer, prosjekter, arbeidsflater)
#   /w/<flate>/...     → code-server i arbeidsflate-containeren (prefiks strippes)
#   /web/<flate>/...   → Vite-websiden i samme container (prefiks beholdes,
#                        Vite kjører med base=/web/<flate>/)
#
# Alt serveres fra samme origin — det er også grunnlaget for se/peke-laget
# i V2 (ghost-cursors over iframes krever same-origin). Lobbyen returnerer
# relative flate-lenker slik at begge innganger beholder sin egen origin.

{
	admin off
	auto_https off
}

(ruting) {
	# Begge innganger logger til samme fil — reaperen (dvale) leser denne,
	# så LAN-aktivitet må telle på lik linje med tailnett-aktivitet.
	log {
		output file /logs/access.log {
			roll_size 20MiB
			roll_keep 3
		}
		format json
	}

	# DET ENE unntaket fra vakten under: arbeidsflater må kunne hente
	# ferske git-tokens (repo-scopet, 1 times levetid) for push/pull mot
	# GitHub. Endepunktet autentiserer med per-arbeidsflate-hemmelighet
	# og utsteder KUN token til flatens eget repo. Hold unntaket minimalt:
	# kun POST, kun denne ene stien.
	@gittoken {
		path /api/git-token
		method POST
	}
	handle @gittoken {
		reverse_proxy s15l-lobby:8200
	}

	# Vakt fra testfunn 22: arbeidsflate-containere (med terminal) skal
	# aldri nå styrende tjenester. De deler docker-nett med caddy (for at
	# caddy skal nå dem), så alt som KOMMER FRA arbeidsflate-subnettet
	# avvises — DNAT bevarer kilde-IP, derfor blokkeres subnett-naboer,
	# ikke «alle utenom gatewayen». Zoo Code når proxyen direkte på
	# docker-nettet og trenger aldri caddy.
	@fra_arbeidsflatenettet client_ip 172.31.15.0/24
	handle @fra_arbeidsflatenettet {
		respond "Styrende tjenester er ikke tilgjengelige fra arbeidsflatene." 403
	}

	@arbeidsflate path_regexp ws ^/w/([a-z0-9-]+)(/.*)?$
	handle @arbeidsflate {
		uri strip_prefix /w/{re.ws.1}
		reverse_proxy s15l-ws-{re.ws.1}:8080
	}

	@webside path_regexp web ^/web/([a-z0-9-]+)(/.*)?$
	handle @webside {
		reverse_proxy s15l-ws-{re.web.1}:5173
	}

	handle {
		reverse_proxy s15l-lobby:8200
	}

	# Dvale/vekke: en stoppet arbeidsflate gir opstream-feil her — da
	# serverer lobbyen vekkesiden (503 + auto-vekking + reload). Hele
	# orig_uri (med query) sendes med slik at ?watch=1 fra veggen når
	# vekkesiden — veggen skal aldri vekke sovende flater.
	handle_errors {
		rewrite * /vekk{http.request.orig_uri}
		reverse_proxy s15l-lobby:8200
	}
}

# Tailnett-inngangen (HTTPS, tailscale-sertifikat)
:8100 {
	tls /certs/raven.crt /certs/raven.key
	import ruting
}

# LAN-inngangen (HTTP). TLS er bevisst utelatt: gyldig sertifikat for en
# LAN-IP finnes ikke, og selvsignert gir verre brukeropplevelse (varsler på
# hver enhet) uten reell gevinst på et lukket studio-nett. Kjente hull over
# http: nettleserens clipboard-API (code-server viser kopier-fallback).
:8101 {
	import ruting
}
